[Unit]
Description=SSL Manager certificate renewal agent
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/opt/sslmgr/venv/bin/python /opt/sslmgr/agents/certificate_agent.py --config /etc/sslmgr-agent/config.json renew
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sslmgr-agent
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
